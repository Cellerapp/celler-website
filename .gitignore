# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# large binaries (host elsewhere, e.g. drive)
/public/*.apk
/src/assets/apk/*.apk

# typescript
*.tsbuildinfo
next-env.d.ts
